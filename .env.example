# Next.js
NEXT_PUBLIC_SITE_URL=https://eqaiglobal.com

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_api_token

# Alternative: Contentful CMS
# CONTENTFUL_SPACE_ID=your_space_id
# CONTENTFUL_ACCESS_TOKEN=your_access_token
# CONTENTFUL_PREVIEW_ACCESS_TOKEN=your_preview_token

# Database (Supabase or Neon)
DATABASE_URL=postgresql://user:password@host:port/database
DIRECT_URL=postgresql://user:password@host:port/database

# NextAuth (if implementing authentication)
# NEXTAUTH_URL=https://eqaiglobal.com
# NEXTAUTH_SECRET=your_secret_key

# Image Optimization (Cloudinary/ImageKit)
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_public_key
# IMAGEKIT_PRIVATE_KEY=your_private_key

# Analytics (Plausible/Matomo)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=eqaiglobal.com
# NEXT_PUBLIC_MATOMO_URL=https://analytics.example.com
# NEXT_PUBLIC_MATOMO_SITE_ID=1

# Error Tracking (Sentry)
# NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# SENTRY_AUTH_TOKEN=your_auth_token

# Search (Typesense/Meilisearch)
# TYPESENSE_HOST=localhost
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http
# TYPESENSE_API_KEY=your_api_key
